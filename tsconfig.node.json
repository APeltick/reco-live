{
  // Reuses the shared strict compiler policy.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Stores incremental-build metadata outside source control.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // Targets modern JavaScript for the local Node.js runtime.
    "target": "ES2023",
    // Provides modern JavaScript type declarations without browser globals.
    "lib": ["ES2023"],
    // Includes Node.js runtime types for tooling files.
    "types": ["node"],
    // Uses Node.js-native ESM module semantics.
    "module": "NodeNext",
    // Resolves imports with Node.js-native ESM semantics.
    "moduleResolution": "NodeNext",
    // Playwright resolves e2e imports with explicit .ts extensions; nothing is emitted.
    "allowImportingTsExtensions": true
  },
  // Type-checks Vite and Playwright configuration and the e2e tests as Node.js tooling.
  "include": ["vite.config.ts", "playwright.config.ts", "tests/e2e/**/*.ts"]
}
