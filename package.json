{
  "name": "draft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint:eslint": "eslint . --cache --cache-strategy content --max-warnings 0",
    "lint:eslint:fix": "npm run lint:eslint -- --fix",
    "lint:styles": "stylelint \"src/**/*.{css,ts,tsx}\"",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "lint": "npm run lint:eslint && npm run lint:styles",
    "build": "tsc -b && vite build",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@mui/x-data-grid": "9.10.0",
    "@reduxjs/toolkit": "2.12.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "9.3.0",
    "react-router": "8.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.6.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-newline-destructuring": "1.2.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-dom": "5.17.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-react-x": "5.17.2",
    "eslint-plugin-regexp": "3.1.1",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "72.0.0",
    "globals": "17.7.0",
    "lefthook": "2.1.10",
    "postcss-styled-syntax": "0.7.2",
    "stylelint": "17.14.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.0",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1"
  },
  "browserslist": [
    "Chrome >= 117",
    "Edge >= 121",
    "Firefox >= 121",
    "Safari >= 17",
    "ios_saf >= 17"
  ]
}
